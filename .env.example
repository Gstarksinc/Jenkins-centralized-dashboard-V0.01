# ==========================================
# Jenkins Control Center - Environment Config
# ==========================================

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME="Jenkins Control Center"
SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex-string
# Fernet encryption key (32 url-safe base64-encoded bytes): python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY_ENCRYPTION=8Z1xVj1xV8zQY7P4wN1vK6tR3bM9eL2sA5hG0yD4fUo=

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=*
ALLOWED_CORS_ORIGINS=["*"]

# Database (PostgreSQL)
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=jenkins_cc
POSTGRES_USER=jenkins_admin
POSTGRES_PASSWORD=jenkins_secure_password_replace_me
DATABASE_URL=postgresql+psycopg://jenkins_admin:jenkins_secure_password_replace_me@postgres:5432/jenkins_cc

# Redis (Cache, Sessions, Celery Broker)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# Celery Worker & Scheduler
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Session & Security Settings
SESSION_COOKIE_NAME=jcc_session
SESSION_EXPIRE_HOURS=12
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
CSRF_COOKIE_NAME=jcc_csrf
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=900

# SSRF Policy (Set to true in test/internal environments to connect to private Jenkins IPs)
ALLOW_PRIVATE_IPS_FOR_JENKINS=true
