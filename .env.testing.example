# ==============================================================
# Jenkins Control Center - Testing Environment Configuration (.env)
# ==============================================================
# Use this configuration when deploying the testing branch alongside
# the main branch on the same server to avoid port and container collisions.

# Docker Compose Stack Namespace (isolates containers, networks, volumes)
COMPOSE_PROJECT_NAME=jcc-test

# Host Port Mappings for Testing Stack
FRONTEND_PORT_HOST=3001
BACKEND_PORT_HOST=8001
POSTGRES_PORT_HOST=5433
REDIS_PORT_HOST=6380

# Application
ENVIRONMENT=testing
LOG_LEVEL=DEBUG
APP_NAME="Jenkins Control Center (Testing)"
SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex-string
SECRET_KEY_ENCRYPTION=8Z1xVj1xV8zQY7P4wN1vK6tR3bM9eL2sA5hG0yD4fUo=

# Backend Server (Internal container settings)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=*
ALLOWED_CORS_ORIGINS=["*"]

# Database (PostgreSQL) - Internal to jcc-test Docker network
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_DB=jenkins_cc_test
POSTGRES_USER=jenkins_admin
POSTGRES_PASSWORD=jenkins_secure_password_replace_me
DATABASE_URL=postgresql+psycopg://jenkins_admin:jenkins_secure_password_replace_me@postgres:5432/jenkins_cc_test

# Redis (Internal to jcc-test Docker network)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# Celery Worker & Scheduler
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Session & Security Settings
SESSION_COOKIE_NAME=jcc_session_test
SESSION_EXPIRE_HOURS=12
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
CSRF_COOKIE_NAME=jcc_csrf_test
RATE_LIMIT_LOGIN_ATTEMPTS=10
RATE_LIMIT_WINDOW_SECONDS=900

# SSRF Policy
ALLOW_PRIVATE_IPS_FOR_JENKINS=true
